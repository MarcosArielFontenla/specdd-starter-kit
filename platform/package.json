{
  "name": "specdd-platform",
  "version": "1.0.0",
  "description": "SpecDD Platform - unified portal for the three SDD wizards",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "bundle-all": "node ../specdd-kit/website/scripts/bundle-kit.js && node ../specforge-kit/website/scripts/bundle-skills.js && node ../specdeploy-kit/website/scripts/bundle-providers.js",
    "predev": "npm run bundle-all",
    "prebuild": "npm run bundle-all",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@specdd/ui": "*",
    "astro": "^5.3.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sdd-kit-wizard": "*",
    "specdeploy-wizard": "*",
    "specforge-wizard": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0"
  }
}
