{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/delivery/1.0.0/receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "runId",
    "deliveryRef",
    "deliverySha256",
    "stage",
    "attempt",
    "adapterRef",
    "environmentRef",
    "sourceRevision",
    "artifactSha256",
    "origin",
    "startedAt",
    "endedAt",
    "outcome",
    "evidence"
  ],
  "properties": {
    "kind": {
      "const": "SpecDDDeliveryReceipt"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "deliveryRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "deliverySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "enum": [
        "source-gate",
        "build",
        "deploy-staging",
        "smoke",
        "approve-promotion",
        "deploy-production",
        "post-deploy"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "adapterRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "artifactSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "enum": [
        "local-observation",
        "imported-attestation"
      ]
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "unknown",
        "success",
        "failed",
        "cancelled"
      ]
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
