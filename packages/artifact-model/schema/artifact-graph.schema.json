{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/artifact-graph/1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectRef", "nodes", "assertions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "kind": {"const": "SpecForgeArtifactGraph"},
    "projectRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "definitionSha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "definitionSha256": {"$ref": "#/$defs/hash"}}
    },
    "nodes": {"type": "array", "minItems": 1, "maxItems": 200, "items": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "artifactId", "revision", "sha256"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"}, "artifactId": {"$ref": "#/$defs/id"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "sha256": {"$ref": "#/$defs/hash"}
      }
    }},
    "assertions": {"type": "array", "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "from", "to", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["depends-on", "derives-from", "refines", "validates", "implements", "supersedes", "blocks", "relates-to"]},
        "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"},
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["actor", "at", "sourceRefs"],
          "properties": {
            "actor": {
              "type": "object", "additionalProperties": false, "required": ["id", "kind"],
              "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["human", "agent", "system"]}}
            },
            "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
            "sourceRefs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
          }
        }
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"}
  }
}
