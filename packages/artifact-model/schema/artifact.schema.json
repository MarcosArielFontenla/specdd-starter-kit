{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/artifact/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "title", "type", "content", "projectRef", "ownerRole", "revision", "previousRevisionSha256", "createdAt", "updatedAt", "provenance", "relationships", "status", "review"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "kind": {"const": "SpecForgeArtifact"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/text"},
    "type": {"enum": ["requirement", "open-question", "decision"]},
    "content": {},
    "projectRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "definitionSha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "definitionSha256": {"$ref": "#/$defs/hash"}}
    },
    "ownerRole": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "previousRevisionSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "createdAt": {"$ref": "#/$defs/time"},
    "updatedAt": {"$ref": "#/$defs/time"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/contribution"}},
    "relationships": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/relationship"}},
    "status": {"enum": ["draft", "under-review", "approved", "active", "superseded"]},
    "review": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/event"}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "requirement"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/requirement"}}}},
    {"if": {"properties": {"type": {"const": "open-question"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/question"}}}},
    {"if": {"properties": {"type": {"const": "decision"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/decision"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["human", "agent", "system"]}}
    },
    "contribution": {
      "type": "object", "additionalProperties": false, "required": ["actor", "origin", "at", "sourceRefs"],
      "properties": {
        "actor": {"$ref": "#/$defs/actor"},
        "origin": {"enum": ["human-authored", "agent-proposed", "human-edited-agent-proposal", "imported", "generated-from-artifact"]},
        "at": {"$ref": "#/$defs/time"},
        "sourceRefs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["kind", "target"],
      "properties": {
        "kind": {"enum": ["depends-on", "derives-from", "relates-to"]},
        "target": {
          "type": "object", "additionalProperties": false, "required": ["projectId", "artifactId", "revision", "sha256"],
          "properties": {"projectId": {"$ref": "#/$defs/id"}, "artifactId": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "sha256": {"$ref": "#/$defs/hash"}}
        }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "actor", "at", "subjectSha256", "previousEventSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "action": {"enum": ["request-review", "return-to-draft", "approve", "activate", "supersede"]},
        "actor": {"$ref": "#/$defs/actor"}, "at": {"$ref": "#/$defs/time"}, "subjectSha256": {"$ref": "#/$defs/hash"},
        "previousEventSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["description", "acceptanceCriteria"],
      "properties": {
        "description": {"$ref": "#/$defs/text"},
        "acceptanceCriteria": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "given", "when", "then"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "given": {"$ref": "#/$defs/text"}, "when": {"$ref": "#/$defs/text"}, "then": {"$ref": "#/$defs/text"}}
        }}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["question", "blocking", "resolution"],
      "properties": {
        "question": {"$ref": "#/$defs/text"}, "blocking": {"type": "boolean"},
        "resolution": {"anyOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["answer", "actor", "at"],
          "properties": {"answer": {"$ref": "#/$defs/text"}, "actor": {"$ref": "#/$defs/actor"}, "at": {"$ref": "#/$defs/time"}}
        }]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["decision", "rationale"],
      "properties": {"decision": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}}
    }
  }
}
