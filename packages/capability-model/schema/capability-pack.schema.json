{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/capability-pack/1.0.0",
  "title": "SpecDD Capability Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "lifecycle", "metadata", "role", "skills", "playbooks",
    "workflows", "policies", "evals", "context", "subagents", "routing", "dependencies"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "SpecDDCapabilityPack" },
    "lifecycle": { "enum": ["draft", "active", "deprecated"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/semver" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "scope": { "$ref": "#/$defs/nonEmptyString" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skill" } },
    "playbooks": { "type": "array", "items": { "$ref": "#/$defs/playbook" } },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
    "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policy" } },
    "evals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eval" } },
    "context": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/context" } },
    "subagents": { "type": "array", "items": { "$ref": "#/$defs/subagent" } },
    "routing": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/)|(^[A-Za-z]:[\\\\/])|(^|[\\\\/])\\.\\.([\\\\/]|$)" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$" },
      "additionalProperties": true
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "version": { "$ref": "#/$defs/semver" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "skillRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "skillRef": { "$ref": "#/$defs/id" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "triggers", "skillRefs", "contextRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "triggers": { "$ref": "#/$defs/stringArray" },
        "skillRefs": { "$ref": "#/$defs/idArray" },
        "contextRefs": { "$ref": "#/$defs/idArray" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "effect": { "enum": ["require", "forbid", "verify"] },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "mode", "targetRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "mode": { "enum": ["disabled", "log_only", "enforced"] },
        "targetRefs": { "$ref": "#/$defs/idArray" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "required": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "subagent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "status", "roleRef", "skillRefs", "workflowRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/portablePath" },
        "status": { "const": "inactive" },
        "roleRef": { "$ref": "#/$defs/id" },
        "skillRefs": { "$ref": "#/$defs/idArray" },
        "workflowRefs": { "$ref": "#/$defs/idArray" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "priority", "skillRef", "workflowRoot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "match": { "$ref": "#/$defs/nonEmptyString" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "skillRef": { "$ref": "#/$defs/id" },
        "workflowRoot": { "$ref": "#/$defs/portablePath" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "versionRange", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["harness", "capability"] },
        "versionRange": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
