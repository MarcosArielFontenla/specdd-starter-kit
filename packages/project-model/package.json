{
  "name": "@specdd/project-model",
  "version": "1.0.0",
  "description": "Runtime-neutral canonical Project Definition for SpecDD",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/project-definition.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test",
    "test": "npm run test:unit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
