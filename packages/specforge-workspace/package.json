  },
  "engines": {"node": ">=22.12.0"},
  "dependencies": {"@specdd/artifact-model": "*", "@specdd/project-model": "*", "@specdd/local-control-service": "*"},
  "devDependencies": {"@playwright/test": "^1.42.0"}
}
