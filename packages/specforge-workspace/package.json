{
  "name": "@specdd/specforge-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.mjs",
  "scripts": {
    "build": "npm run build -w @specdd/artifact-model && npm run build -w @specdd/local-control-service",
