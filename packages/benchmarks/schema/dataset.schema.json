{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/benchmark/1.0.0/dataset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "planSha256",
    "samples"
  ],
  "properties": {
    "kind": {
      "const": "SpecDDBenchmarkDataset"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "samples": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "configurationRef",
          "configurationSha256",
          "taskSha256",
          "repetition",
          "controlPlane",
          "events",
          "cost"
        ],
        "properties": {
          "configurationRef": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "configurationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "taskSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "controlPlane": {
            "$ref": "https://specdd.dev/schemas/control-plane/1.0.0/control-plane.schema.json"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "https://specdd.dev/schemas/run-history/1.0.0/event.schema.json"
            }
          },
          "cost": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amount",
                  "currency",
                  "evidence"
                ],
                "properties": {
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "bytes"
                    ],
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
