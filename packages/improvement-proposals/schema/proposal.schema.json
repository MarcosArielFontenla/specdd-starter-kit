{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/improvements/1.0.0/proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "title",
    "target",
    "hypothesis",
    "change",
    "risks",
    "rollback",
    "source",
    "benchmark",
    "acceptance"
  ],
  "properties": {
    "kind": {
      "const": "SpecDDImprovementProposal"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "beforeSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "change": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "risks": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "rollback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSha256",
        "datasetSha256"
      ],
      "properties": {
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "datasetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSha256",
        "candidateRef"
      ],
      "properties": {
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "direction",
          "minimumDelta"
        ],
        "properties": {
          "metric": {
            "enum": [
              "score",
              "passed",
              "executionError",
              "latencyMs",
              "retries",
              "cost"
            ]
          },
          "direction": {
            "enum": [
              "increase",
              "decrease"
            ]
          },
          "minimumDelta": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
