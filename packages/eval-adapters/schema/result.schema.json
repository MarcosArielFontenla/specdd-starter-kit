{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specdd.dev/schemas/eval/1.0.0/result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "runId", "inputRef", "observedAt", "evalRef", "evalVersion", "definitionSha256", "adapter", "outcome", "score", "label", "evidence", "error"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "kind": {"const": "SpecDDEvalResult"},
    "runId": {"type":"string","minLength":1}, "inputRef": {"type":"string","minLength":1},
    "observedAt": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "evalRef": {"type":"string","minLength":1}, "evalVersion": {"type":"string","minLength":1},
    "definitionSha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}, "adapter": {"type":"string","minLength":1},
    "outcome": {"enum":["pass","fail","error"]}, "score": {"type":["number","null"],"minimum":0,"maximum":1},
    "label": {"type":["string","null"]}, "error": {"type":["string","null"]},
    "evidence": {"type":"object","additionalProperties":false,"required":["sha256","bytes"],"properties":{
      "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":0}
    }}
  },
  "allOf": [{"if":{"properties":{"outcome":{"const":"error"}}},"then":{"properties":{"score":{"type":"null"},"label":{"type":"null"},"error":{"type":"string","minLength":1}}},"else":{"properties":{"score":{"type":"number"},"label":{"type":"string","minLength":1},"error":{"type":"null"}}}}]
}
